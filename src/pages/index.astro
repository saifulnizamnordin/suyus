---
import { ArrowRight, ClipboardList, FileText, GitPullRequest, Heart, Plus, RefreshCw, UserCheck } from "lucide-react"
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import PortfolioCard from "@/components/PortfolioCard"
import { getPortfolios, toDirectoryEntry } from "@/lib/portfolios"
import { portfolioPath, site } from "@/site"

const portfolios = await getPortfolios()
const HOME_LIMIT = 6
const featured = portfolios.slice(0, HOME_LIMIT).map(toDirectoryEntry)

const steps = [
  {
    icon: ClipboardList,
    title: "Fill in a form, or write the file",
    body: "Sign in with GitHub and fill in your page step by step. Prefer Git? Copy the Markdown template instead.",
  },
  {
    icon: GitPullRequest,
    title: "A pull request in your name",
    body: "The form opens it for you; with Git you open it yourself. Either way, your page is one Markdown file.",
  },
  {
    icon: UserCheck,
    title: "Checked & published",
    body: "A check confirms the file matches your GitHub account. Once merged, your page goes live.",
  },
]
---

<Layout title={`${site.name} — ${site.tagline}`} description={site.description}>
  <SiteHeader nav={[{ href: "#how-it-works", label: "How it works" }]} />

  <main class="mx-auto max-w-3xl px-4">
    <section class="pt-14 pb-6 sm:pt-20">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">Open-source portfolios</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{site.tagline}</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        A free, simple page for anyone with a GitHub account: designers, writers, engineers, students. Fill in a short form
        (or write one Markdown file) and get a page at
        <code class="rounded bg-muted px-1.5 py-0.5 text-base text-foreground">{site.domain}/p/&lt;username&gt;</code>.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href={site.submitPath}
          class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/80"
        >
          <Plus className="size-4" /> Submit your portfolio
        </a>
        <a
          href={site.templateUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-sm font-medium hover:bg-muted"
        >
          <FileText className="size-4" /> View the template
        </a>
      </div>
    </section>

    <section id="portfolios" class="scroll-mt-20 pt-12">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">Directory</p>
          <h2 class="mt-1 text-2xl font-semibold tracking-tight">Portfolios</h2>
        </div>
        <a href="/p" class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
          Browse all {portfolios.length} <ArrowRight className="size-4" />
        </a>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2">
        {featured.map((entry) => (
          <li>
            <PortfolioCard entry={entry} />
          </li>
        ))}
        <li>
          <a
            href={site.submitPath}
            class="flex h-full min-h-40 flex-col items-center justify-center gap-2 rounded-xl border border-dashed p-4 text-center text-sm text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
          >
            <Plus className="size-5" />
            <span class="font-medium">Add your portfolio</span>
            <span class="text-xs">Fill in a form or open a pull request.</span>
          </a>
        </li>
      </ul>
      {portfolios.length > HOME_LIMIT && (
        <div class="mt-4 flex justify-center">
          <a href="/p" class="inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-sm font-medium hover:bg-muted">
            Browse and search all {portfolios.length} portfolios <ArrowRight className="size-4" />
          </a>
        </div>
      )}
    </section>

    <section id="how-it-works" class="scroll-mt-20 pt-16">
      <p class="text-xs font-medium tracking-widest text-muted-foreground uppercase">Submit</p>
      <h2 class="mt-1 text-2xl font-semibold tracking-tight">How it works</h2>
      <ol class="mt-6 grid gap-3 sm:grid-cols-3">
        {steps.map((step, i) => (
          <li class="rounded-xl border bg-card p-4">
            <div class="flex items-center gap-2">
              <span class="flex size-8 items-center justify-center rounded-md bg-muted">
                <step.icon className="size-4" />
              </span>
              <span class="text-xs text-muted-foreground tabular-nums">Step {i + 1}</span>
            </div>
            <p class="mt-3 font-medium">{step.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))}
      </ol>
      <div class="mt-3 flex items-start gap-3 rounded-xl bg-muted/50 p-4 text-sm">
        <RefreshCw className="mt-0.5 size-4 shrink-0 text-muted-foreground" />
        <p class="leading-relaxed text-muted-foreground">
          <span class="font-medium text-foreground">Changed your GitHub username?</span> A daily job follows your GitHub account
          ID, moves your page to <code>/p/&lt;new-username&gt;</code> and keeps the old address redirecting to it.
        </p>
      </div>
      <div class="mt-6">
        <a
          href={site.submitPath}
          class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/80"
        >
          Choose how to submit <ArrowRight className="size-4" />
        </a>
      </div>
    </section>

    <section id="sponsor" class="scroll-mt-20 pt-16">
      <div class="flex flex-col gap-4 rounded-xl border bg-card p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="flex items-center gap-1.5 font-medium">
            <Heart className="size-4 text-pink-600 dark:text-pink-400" /> Free for everyone, kept going by sponsors
          </p>
          <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
            No ads, no tracking, no paid plans. Sponsoring covers running the site and reviewing every submission.
          </p>
        </div>
        <a
          href={site.sponsorPath}
          class="inline-flex h-9 shrink-0 items-center gap-1.5 self-start rounded-lg border px-3 text-sm font-medium hover:bg-muted sm:self-auto"
        >
          Sponsor Suyus <ArrowRight className="size-4" />
        </a>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>
