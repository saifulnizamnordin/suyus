---
import Layout from "@/layouts/Layout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { site } from "@/site"
---

<Layout title={`Not found — ${site.name}`} description="This page doesn't exist.">
  <script is:inline>
    // Portfolios are served without a trailing slash (/p/<username>), so retry old /p/<username>/ links without it.
    // Only that exact shape is retried, so a missing page can't redirect in a loop.
    if (/^\/p\/[a-z0-9-]+\/$/i.test(location.pathname)) {
      location.replace(location.pathname.slice(0, -1) + location.search + location.hash)
    } else if (location.pathname === "/p/") {
      location.replace("/#portfolios")
    }
  </script>
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-4">
    <section class="pt-16">
      <p class="text-sm text-muted-foreground tabular-nums">404</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight">Page not found</h1>
      <p class="mt-3 leading-relaxed text-muted-foreground">
        There's no portfolio or page at this address.
        <a class="underline underline-offset-4 hover:text-foreground" href="/#portfolios">Browse all portfolios</a>, or
        <a class="underline underline-offset-4 hover:text-foreground" href={site.submissionUrl} target="_blank" rel="noreferrer">submit your own</a>.
      </p>
    </section>
    <SiteFooter />
  </main>
</Layout>
